# ==================================================================
# StudyHelper 环境变量配置
# 复制此文件为 .env 并按需修改：cp .env.example .env
#
# 注意：容器间通信地址（如 DB_HOST、REDIS_HOST）已在
# docker-compose.yml 的 environment 中覆盖为容器服务名，
# 此处定义的是宿主机访问地址和本地开发时 FastAPI 使用的地址。
# ==================================================================

# ------------------------------------------------------------------
# Nginx
# ------------------------------------------------------------------
NGINX_HTTP_PORT=8080

# ------------------------------------------------------------------
# 业务数据库（PostgreSQL + pgvector）
# ------------------------------------------------------------------
BUSINESS_DB_USER=studyhelper
BUSINESS_DB_PASSWORD=studyhelper123
BUSINESS_DB_NAME=studyhelper
# 容器内通信地址（docker-compose.yml 中覆盖）
DB_HOST=localhost
DB_PORT=5433
# 映射到宿主机的端口（避免与 Dify 的 PostgreSQL 5432 冲突）
BUSINESS_DB_HOST_PORT=5433

# ------------------------------------------------------------------
# Redis
# ------------------------------------------------------------------
# 容器内通信地址（docker-compose.yml 中覆盖）
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_PASSWORD=studyhelper123
# 映射到宿主机的端口（避免与 Dify 的 Redis 6379 冲突）
REDIS_HOST_PORT=6380

# ------------------------------------------------------------------
# 对象存储（MinIO）
# ------------------------------------------------------------------
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=studyhelper
# 容器内通信地址（docker-compose.yml 中覆盖）
MINIO_ENDPOINT=localhost:9100
# 映射到宿主机的端口（避免与常见本地服务 9000 冲突）
MINIO_API_PORT=9100
MINIO_CONSOLE_PORT=9101

# ------------------------------------------------------------------
# 代码沙箱
# 以下变量供 FastAPI 代码使用（Docker SDK 启动沙箱容器时传入资源限制）
# 非 docker-compose.yml 直接引用
# ------------------------------------------------------------------
SANDBOX_TIMEOUT=5
SANDBOX_MEMORY_LIMIT=256m
SANDBOX_CPU_LIMIT=1.0

# ------------------------------------------------------------------
# Dify 连接配置
# Dify 使用官方 docker-compose 运行，通过共享网络访问
# 容器内通信地址（docker-compose.yml 中覆盖）
# Dify 的 api 服务加入 studyhelper_net 后，可直接用服务名 api 访问
# 注意：端口号需与 Dify 版本一致，1.14.0 版本 API 监听 5001
# ------------------------------------------------------------------
DIFY_API_URL=http://localhost:5001
DIFY_API_KEY=your-dify-app-api-key

# ------------------------------------------------------------------
# 大模型 API Key
# 统一在 Dify 管理后台配置：设置 → 模型供应商 → 填入 API Key
# 不在项目中存储，职责分离，避免泄露风险
# ------------------------------------------------------------------
